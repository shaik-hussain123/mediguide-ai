# Copy to .env or export in your shell. All optional for local use.
PORT=5600
NODE_ENV=development            # set to production behind HTTPS (enables Secure cookies + HSTS)
# JWT_SECRET=...                # else generated once into data/.secrets.json
# SERVER_SECRET=...             # encrypts the stored Gemini key (AES-256-GCM)
# GEMINI_API_KEY=...            # optional fallback; the admin normally sets the key in the app
# OAuth2 / OIDC sign-in (Google defaults). Leave empty to hide the button.
# OAUTH_CLIENT_ID=
# OAUTH_CLIENT_SECRET=
# OAUTH_REDIRECT_URI=http://localhost:5600/api/auth/oauth/callback
