# MediGuide AI Production Environment Configuration
# Copy this file to .env.production and update values for your deployment
# WARNING: Never commit .env.production with real passwords/secrets!

# ── Backend Configuration ──────────────────────────────────────────────────────

# JWT Security (MUST be set to a strong random value in production)
SECRET_KEY=your_production_secret_key_at_least_64_characters_long_generate_with_openssl_rand_hex_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# MongoDB Configuration
MONGODB_URL=mongodb://admin:production_mongodb_password@localhost:27017/mediguide_db?authSource=admin
DATABASE_NAME=mediguide_db

# CORS Configuration (restrict to your production domain)
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# File Upload Limits (production values)
MAX_UPLOAD_SIZE=10485760
MAX_JSON_SIZE=1048576

# Admin Configuration (CHANGE THESE BEFORE DEPLOYMENT)
ADMIN_EMAIL=admin@mediguide.ai
ADMIN_PASSWORD=create_a_strong_admin_password_minimum_16_characters_with_special_chars

# ── Production Security Settings ────────────────────────────────────────────────

# Enable HTTPS in production (set via reverse proxy in most cases)
NODE_ENV=production

# Rate Limiting (requests per minute)
AUTH_RATE_LIMIT=5
API_RATE_LIMIT=60

# Content Security Policy
# This allows scripts from self and CDN, connects to self and Overpass API
CSP_POLICY=default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; img-src 'self' data: https:; font-src 'self' https://cdn.jsdelivr.net; connect-src 'self' https://overpass-api.de; frame-ancestors 'none'; base-uri 'self'; form-action 'self'

# ── Database Seeding ───────────────────────────────────────────────────────────

# Skip seeding on production (medications already seeded)
SKIP_SEEDING=true

# ── Monitoring (optional) ─────────────────────────────────────────────────────

# Sentry DSN for error tracking (optional)
# SENTRY_DSN=https://key@sentry.io/project

# ── Logging ─────────────────────────────────────────────────────────────────────

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# ── Volume Mounts (for Docker) ─────────────────────────────────────────────────

# Uploads directory (should be a persistent volume in production)
# UPLOAD_DIR=/app/uploads

# ── Production Checklist ───────────────────────────────────────────────────────

# BEFORE DEPLOYMENT:
# 1. Generate a new SECRET_KEY: openssl rand -hex 32
# 2. Set strong MONGO_ROOT_PASSWORD and MONGO_ROOT_USERNAME
# 3. Set strong ADMIN_PASSWORD (min 16 chars with uppercase, lowercase, numbers, special chars)
# 4. Update ALLOWED_ORIGINS to your actual domain
# 5. Configure SSL/TLS certificate (via reverse proxy or certbot)
# 6. Set up backup strategy for MongoDB
# 7. Configure monitoring (Sentry, Prometheus, etc.)
# 8. Test all endpoints with authentication